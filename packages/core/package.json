{
  "name": "@xmsbl/quilldown-core",
  "version": "0.3.0",
  "description": "Contract constants + form binding; re-exports the Markdown-to-HTML pipeline from @xmsbl/quilldown-render.",
  "license": "MIT",
  "author": "chengshy123 <88560859@qq.com>",
  "keywords": [
    "markdown",
    "marked",
    "prismjs",
    "syntax-highlighting",
    "renderer"
  ],
  "homepage": "https://github.com/xmsbl/quilldown#readme",
  "bugs": "https://github.com/xmsbl/quilldown/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xmsbl/quilldown.git",
    "directory": "packages/core"
  },
  "type": "module",
  "comment:sideEffects": "不能标 false：本包入口有真副作用（加载 Prism 语言组件 + 挂 globalThis.Prism）。标了 false 时 rollup 会把 `import \"prismjs/components/...\"` 整段摇掉 → 代码块静默不高亮（实测过）。",
  "sideEffects": true,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.iife.js",
  "jsdelivr": "./dist/index.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@xmsbl/quilldown-render": "^0.3.0"
  }
}
