{
  "name": "@xmsbl/quilldown-edodo",
  "version": "0.3.0",
  "type": "module",
  "description": "Fork of edodo-write (MIT) kept as an internal package — install @xmsbl/quilldown-wysiwyg instead. Upstream: https://github.com/vivmagarwal/edodo-write @ a7960a0 (upstream v0.10.0; this package's version is independent of upstream's). See UPSTREAM.md.",
  "license": "MIT",
  "author": "vivmagarwal",
  "homepage": "https://github.com/xmsbl/quilldown#readme",
  "bugs": "https://github.com/xmsbl/quilldown/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xmsbl/quilldown.git",
    "directory": "packages/edodo"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/lib/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./plugins": {
      "types": "./dist-lib/plugins/index.d.ts",
      "import": "./dist-lib/plugins.js"
    },
    "./parse": {
      "types": "./dist-lib/lib/parse-api.d.ts",
      "import": "./dist-lib/parse.js"
    },
    "./styles.css": "./dist-lib/edodo-write.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist-lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.app.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.61",
    "@xmsbl/quilldown-render": "^0.3.0",
    "dom-serializer": "^2.0.0",
    "domhandler": "^5.0.3",
    "htmlparser2": "^9.1.0",
    "marked": "^18.1.0",
    "prismjs": "^1.30.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@types/turndown": "^5.0.5",
    "@types/prismjs": "^1.26.6",
    "edododraw": "^0.1.4",
    "jsdom": "^30.1.2",
    "katex": "^0.17.0",
    "typescript": "^5",
    "vite": "^7",
    "vitest": "^5"
  }
}
