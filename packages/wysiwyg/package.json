{
  "name": "@xmsbl/quilldown-wysiwyg",
  "version": "0.3.0",
  "description": "WYSIWYG Markdown editor (contenteditable, edodo-write based).",
  "license": "MIT",
  "author": "chengshy123 <88560859@qq.com>",
  "keywords": [
    "markdown",
    "editor",
    "wysiwyg",
    "contenteditable"
  ],
  "homepage": "https://github.com/xmsbl/quilldown#readme",
  "bugs": "https://github.com/xmsbl/quilldown/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xmsbl/quilldown.git",
    "directory": "packages/wysiwyg"
  },
  "type": "module",
  "comment:sideEffects": "不能标 false：vendored 的 edodo 原件里一堆顶层定义（插件表 / 指令表）参与副作用分析，标了会被摇掉。",
  "sideEffects": true,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.iife.js",
  "jsdelivr": "./dist/index.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./index.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@xmsbl/quilldown-core": "^0.3.0",
    "@xmsbl/quilldown-edodo": "^0.3.0",
    "@xmsbl/quilldown-render": "^0.3.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
