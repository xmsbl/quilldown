{
  "name": "@xmsbl/wysiwyg",
  "version": "0.1.0",
  "description": "WYSIWYG Markdown editor (contenteditable, edodo-write based).",
  "license": "MIT",
  "author": "chengshy123 <88560859@qq.com>",
  "keywords": [
    "markdown",
    "editor",
    "wysiwyg",
    "contenteditable"
  ],
  "type": "module",
  "comment:sideEffects": "不能标 false：vendored 的 edodo 原件里一堆顶层定义（插件表 / 指令表）参与副作用分析，标了会被摇掉。",
  "sideEffects": true,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.iife.js",
  "jsdelivr": "./dist/index.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./zh": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.zh.js"
    },
    "./index.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@xmsbl/core": "^0.1.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "vendor": "node scripts/vendor.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
