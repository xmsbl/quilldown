{
  "name": "@xmsbl/quilldown-render",
  "version": "0.1.0",
  "description": "The single Markdown-to-HTML pipeline (marked GFM + Prism + heading ids + line anchors).",
  "license": "MIT",
  "type": "module",
  "comment:sideEffects": "不能标 false：入口有真副作用（加载 Prism 语言组件 + 挂 globalThis.Prism），标 false 会被摇掉 → 代码块静默不高亮。",
  "sideEffects": true,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.iife.js",
  "jsdelivr": "./dist/index.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "dom-serializer": "^2.0.0",
    "domhandler": "^5.0.3",
    "htmlparser2": "^9.1.0",
    "marked": "^18.1.0",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@types/prismjs": "^1.26.6"
  }
}
